{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "services": [
    {
      "binding": "RAG_AI_CV",
      "service": "rag-ai-cv"
    }
  ],
  "ratelimits": [
    {
      "name": "EXPENSIVE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {"limit": 3, "period": 60}
    }
  ]
