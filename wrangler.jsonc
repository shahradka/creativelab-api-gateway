{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "services": [
    {
      "binding": "RAG_AI_CV",
      "service": "rag-ai-cv"
    }
  ],
  "ratelimits": [
    {
      "name": "EXPENSIVE_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {"limit": 3, "period": 60}
    }
  ],
  // Set the API key used by protected routes with:
  //   wrangler secret put API_KEY
  //
  // Set the private secret used to sign service-to-service JWTs with:
  //   wrangler secret put SERVICE_JWT_SECRET
  //
  // The SAME secret must be configured on every upstream service (e.g. rag-ai-cv)
  // so it can verify the `x-service-token` header. Generate one with:
  //   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
  //
  // Comma-separated CORS allowlist. Use "*" to allow every origin.
  "vars": {
    "CORS_ORIGINS": "",
    "SERVICE_JWT_ISSUER": "api-gateway",
    "SERVICE_JWT_AUDIENCE": "internal-services",
    "SERVICE_JWT_TTL_SECONDS": "60"
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}